# Copy to .env and fill in. Expo only exposes variables prefixed EXPO_PUBLIC_.
# Both of these are safe in the app: the anon key is public by design and is
# constrained by row level security. Never put a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
