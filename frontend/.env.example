# Copy to .env and fill in. Expo only exposes variables prefixed EXPO_PUBLIC_.
# These are safe in the app: the anon key is public by design and is constrained
# by row level security. Never put a service_role key or a database connection
# string here — everything EXPO_PUBLIC_ is compiled into the installed app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The machine running FastAPI. On a phone, localhost is the phone itself, so this
# must be your computer's LAN address — find it with `ipconfig`. While this is
# unset, client.ts serves fixture data and no request is made at all.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
